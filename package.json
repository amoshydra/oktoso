{
  "name": "@amoshydra/oktoso",
  "version": "0.1.4",
  "private": false,
  "description": "Oktoso — hub and control plane for AI agents across providers and wearable clients.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "oktoso": "dist/hub.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:even-g2": "tsx scripts/dev-even-g2.ts",
    "simulate:even-g2": "pnpm --filter @amoshydra/oktoso-even-g2 simulate",
    "build": "pnpm build:hub && pnpm build:web && pnpm build:even-g2",
    "build:hub": "tsup",
    "build:web": "pnpm --filter @amoshydra/oktoso-web build",
    "build:even-g2": "pnpm --filter @amoshydra/oktoso-even-g2 build",
    "build:even-g2:hosted": "pnpm --filter @amoshydra/oktoso-even-g2 run build:hosted",
    "build:single-port": "pnpm build:hub && pnpm build:web && pnpm build:even-g2:hosted",
    "pack:even-g2": "pnpm --filter @amoshydra/oktoso-even-g2 run pack",
    "start": "node dist/hub.js",
    "start:local": "tsx scripts/start-local.ts",
    "pair": "tsx packages/hub/src/main.ts --pair",
    "pair:dev": "tsx scripts/pair-dev.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "prototype": "python3 -m http.server 4174 --bind 0.0.0.0 --directory docs/prototypes",
    "prepublishOnly": "pnpm build:single-port",
    "hardware:check": "pnpm --filter @amoshydra/oktoso-even-g2 hardware:check"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "@asteasolutions/zod-to-openapi": "^9.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "opencode",
    "openwebui",
    "even-g2"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amoshydra/oktoso.git"
  },
  "homepage": "https://github.com/amoshydra/oktoso",
  "bugs": {
    "url": "https://github.com/amoshydra/oktoso/issues"
  }
}
