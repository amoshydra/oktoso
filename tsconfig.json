{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@agent-hub/contracts": ["packages/contracts/src/index.ts"],
      "@agent-hub/providers": ["packages/providers/src/index.ts"],
      "@agent-hub/storage": ["packages/storage/src/index.ts"],
      "@agent-hub/hub": ["packages/hub/src/index.ts"],
      "@agent-hub/client": ["packages/client/src/index.ts"],
      "@agent-hub/ui": ["packages/ui/src/index.ts"],
      "@agent-hub/testing": ["packages/testing/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "tsup.config.ts"
  ],
  "exclude": ["node_modules", "dist", "docs"]
}
