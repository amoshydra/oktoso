{
  "host": "127.0.0.1",
  "port": 8787,
  "token": "${HUB_TOKEN}",
  "dataDir": ".data",
  "cors": ["http://localhost:5175", "http://127.0.0.1:5175"],
  "providers": [
    {
      "id": "desktop-opencode",
      "type": "opencode",
      "name": "desktop-opencode",
      "baseUrl": "${OPENCODE_BASE_URL}",
      "auth": {
        "kind": "basic",
        "username": "${OPENCODE_USERNAME}",
        "password": "${OPENCODE_PASSWORD}"
      },
      "enabled": true
    },
    {
      "id": "openwebui",
      "type": "openwebui",
      "name": "openwebui",
      "baseUrl": "http://127.0.0.1:4102",
      "auth": {
        "kind": "bearer",
        "token": "${OPENWEBUI_API_KEY}"
      },
      "enabled": true
    },
    {
      "id": "rpi-hermes",
      "type": "hermes",
      "name": "rpi-hermes",
      "baseUrl": "http://127.0.0.1:4103",
      "auth": {
        "kind": "bearer",
        "token": "${HERMES_API_KEY}"
      },
      "enabled": true
    }
  ]
}
