# Hub
HUB_HOST=127.0.0.1
HUB_PORT=8787
# Owner/recovery token. Rotating it revokes every paired session.
HUB_TOKEN=replace-with-a-long-random-token
# Comma-separated origins. Use * only for trusted local hardware testing.
HUB_CORS=http://localhost:5175,http://127.0.0.1:5175
HUB_CONFIG=./hub.config.json
LOG_LEVEL=info
# TUI logs: OS state/log directory by default. Two files, 25 MiB each.
# HUB_LOG_DIR=
# HUB_LOG_MAX_BYTES=26214400

# Provider credentials live in hub.config.json or in environment variables
# referenced from that file. Do not commit real secrets.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
OPENWEBUI_BASE_URL=https://openwebui.example
OPENWEBUI_API_KEY=
HERMES_API_KEY=
